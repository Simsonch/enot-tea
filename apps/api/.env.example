DATABASE_URL="postgresql://enot:enot-tea-password@localhost:5432/enot_tea_dev?schema=public"
PORT=3000
NODE_ENV=development
SWAGGER_DISABLE=0
JWT_SECRET="change-me-for-local-dev"
CORS_ALLOWED_ORIGINS="http://localhost:3100,http://localhost:3200"
THROTTLE_GLOBAL_LIMIT=120
THROTTLE_GLOBAL_TTL_MS=60000
THROTTLE_AUTH_LOGIN_LIMIT=5
THROTTLE_AUTH_LOGIN_TTL_MS=60000
THROTTLE_ORDER_CREATE_LIMIT=20
THROTTLE_ORDER_CREATE_TTL_MS=60000
EMAIL_PROVIDER=log
EMAIL_FROM="Enot Tea <no-reply@example.com>"
EMAIL_REQUEST_TIMEOUT_MS=5000
# Required only when EMAIL_PROVIDER=resend. Do not commit real API keys.
RESEND_API_KEY=""
PRODUCT_IMAGE_STORAGE_DIR="./storage/products"
PRODUCT_IMAGE_BASE_URL="/uploads/products"
PRODUCT_IMAGE_MAX_SIZE_BYTES=5242880
PRODUCT_IMAGE_ALLOWED_MIME_TYPES="image/png,image/jpeg"
